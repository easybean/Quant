[Unit]
Description=Refresh Massive current US acquisition reference and official aliases
Requires=mihomo.service
After=mihomo.service quant-security-catalogue.service

[Service]
Type=oneshot
WorkingDirectory=/home/davidou/quant/app
Environment=PYTHONPATH=/home/davidou/quant/app/src
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
ExecStart=/home/davidou/quant/venv/bin/python -m quant_data.massive_refresh --data-root /home/davidou/quant/data --security-master /home/davidou/quant/data/metadata/security_master.parquet --credential-file /home/davidou/massivekey
TimeoutStartSec=30min
UMask=0077
Nice=10
NoNewPrivileges=true
