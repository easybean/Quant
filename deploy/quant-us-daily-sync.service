[Unit]
Description=Resume all eligible US daily gaps with isolated free providers
Requires=mihomo.service
After=network-online.target mihomo.service

[Service]
Type=oneshot
WorkingDirectory=/home/davidou/quant/app
Environment=PYTHONPATH=/home/davidou/quant/app/src
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=localhost,127.0.0.1,::1
ExecStart=/home/davidou/quant/venv/bin/python -m quant_data.sync_scheduler --security-master /home/davidou/quant/data/metadata/security_master.parquet --data-root /home/davidou/quant/data --credential-file /home/davidou/alpacakey --provider-budget 240
TimeoutStartSec=25min
Nice=10
UMask=0077

