[Unit]
Description=Resume real per-code Massive US daily coverage tests
Requires=mihomo.service
After=mihomo.service

[Service]
Type=oneshot
WorkingDirectory=/home/davidou/quant/app
Environment=PYTHONPATH=/home/davidou/quant/app/src
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=localhost,127.0.0.1,::1
ExecStart=/home/davidou/quant/venv/bin/python -m quant_data.massive_probe --data-root /home/davidou/quant/data --security-master /home/davidou/quant/data/metadata/security_master.parquet --credential-file /home/davidou/massivekey --date 2026-09-17 --limit 60
ExecStartPost=/home/davidou/quant/venv/bin/python -c 'import json,subprocess; from pathlib import Path; p=Path("/home/davidou/quant/data/manifests/massive-code-audit-v1/latest.json"); s=json.loads(p.read_text()) if p.exists() else {}; subprocess.run(["systemctl","--user","disable","--now","quant-massive-code-audit.timer"],check=True) if s.get("status") in {"complete","blocked"} else None'
TimeoutStartSec=50min
UMask=0077
Nice=10
NoNewPrivileges=true
