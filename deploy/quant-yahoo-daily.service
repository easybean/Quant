[Unit]
Description=Quant Yahoo daily bars sync (unqualified research input)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/davidou/quant/app
Environment=PYTHONPATH=/home/davidou/quant/app/src
ExecStart=/home/davidou/quant/venv/bin/python -m quant_data.daily_sync --security-master /home/davidou/quant/data/metadata/security_master.parquet --data-root /home/davidou/quant/data --start 2016-01-01 --request-delay 2 --max-consecutive-failures 3 --max-backfill-symbols 100
TimeoutStartSec=20h
SuccessExitStatus=2
Nice=10
UMask=0077
