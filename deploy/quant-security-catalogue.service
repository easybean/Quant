[Unit]
Description=Import local US security master into provisional reference catalogue

[Service]
Type=oneshot
WorkingDirectory=/home/davidou/quant/app
Environment=PYTHONPATH=/home/davidou/quant/app/src
ExecStart=/home/davidou/quant/venv/bin/python -m quant_data.security_catalog --master /home/davidou/quant/data/metadata/security_master.consolidated.parquet --state-root /home/davidou/quant/app/data/workbench-state
TimeoutStartSec=10min
Nice=10
UMask=0077

